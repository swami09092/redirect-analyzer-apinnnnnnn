*.py[cod]
*$py.class
*.so
.Python
*.py
env/
venv/
ENV/
*.egg-info/
dist/
build/

# Database (Old SQLite/PostgreSQL - replaced by Cloudflare KV)
*.db
*.db-journal
*.sqlite
*.sqlite3
data/

